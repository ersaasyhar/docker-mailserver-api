# Server Binding
# Required: Dedicated Tailscale IPv4 address in 100.64.0.0/10 present on a local network interface.
TAILSCALE_IP=100.64.0.1
PORT=3000

# Authentication & Tenancy
# Required: Minimum 32-byte secret token for admin API access (Authorization: Bearer <token>)
ADMIN_API_TOKEN=replace-with-at-least-32-byte-secure-random-token
# Required: Comma-separated list of managed DNS domains in lowercase
MAIL_DOMAINS=korintus.me

# Docker Mailserver Host Integration
# Required: Target docker container name (valid container name, no leading dash)
DMS_CONTAINER=mailserver

# IMAP Access (Dovecot Master User)
# IMAP always uses implicit TLS (default port 993)
IMAP_HOST=127.0.0.1
IMAP_PORT=993
IMAP_MASTER_USER=mail-api
IMAP_MASTER_PASSWORD=replace-with-dovecot-master-password

# SMTP Submission (Admin Account)
# SMTP always uses required STARTTLS (default port 587)
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_USER=admin@korintus.me
SMTP_PASSWORD=replace-with-admin-smtp-password

# TLS Verification
# Required: DNS name matching actual server certificate presented by IMAP/SMTP
MAIL_TLS_SERVERNAME=mail.korintus.me
# Optional: Path to custom CA certificate file for self-signed or private PKI validation
# MAIL_TLS_CA_FILE=/etc/ssl/certs/custom-ca.pem

# Cross-Origin Resource Sharing (CORS)
# Optional: Comma-separated list of exact HTTP/HTTPS origins permitted to access the API.
# Wildcards, paths, userinfo, and "null" origins are strictly rejected.
# CORS_ORIGINS=https://mail-admin.korintus.me
